# Atlas Export - Environment Configuration
# Copy this file to .env and fill in your values.

ATLAS_HOST=cluster0.abc123.mongodb.net
ATLAS_USERNAME=your_username
ATLAS_PASSWORD=your_password
ATLAS_PROJECT=YourProject
ATLAS_CLUSTER=YourCluster

# Optional
# ATLAS_FILTER=Action_hub_
# ATLAS_OUTPUT_DIR=./atlas-export
# ATLAS_MAX_FILE_SIZE=500M
# ATLAS_BACKUP_NAME=my_backup
